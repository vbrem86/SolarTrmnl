# Kopieren nach .env, Werte eintragen. .env nicht ins Git einchecken.

# Datenquelle: cloud (Standard) oder local
SM_SOURCE=cloud

# Cloud-API v3 (gleiche Werte wie in SolarWatch/local.properties)
# Schlüssel: Solar Manager Web-App -> Profil -> Cloud-API-Schlüssel, OHNE "Erneuerung erlauben"
SM_ID=DEINE_SM_ID
SM_API_KEY=dein-cloud-api-key

# Lokales Gateway (nur bei SM_SOURCE=local)
# SM_IP=192.168.1.231

# Server
PORT=8080
REFRESH_SECONDS=300
IMAGE_FORMAT=png

# Bus (öV-Daten Schweiz, transport.opendata.ch, kein Schlüssel nötig).
# Werte mit Leerzeichen in Anführungszeichen setzen. Leer = Bus-Spalte zeigt einen Hinweis.
# BUS_STATION="Bern, Bahnhof"         # Haltestelle wie auf sbb.ch
# BUS_LINES="10,19"                   # nur diese Linien (leer = alle)
# BUS_VIA="Bern, Zytglogge"           # nur Kurse, die danach hier halten (Namensanfang)
# BUS_VIA_LABEL="Zytglogge"           # Text unter „Bus“
# BUS_COUNT=5
